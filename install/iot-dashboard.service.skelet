# Vorlage fuer den systemd-Dienst des IoT-Dashboards.
# install/install.sh ersetzt die Platzhalter und installiert die Unit nach
# /etc/systemd/system/iot-dashboard.service.
#   @APP_DIR@   Verzeichnis des Dashboards (mit app.py)
#   @PYTHON@    Python-Interpreter des venv (mit Flask, requests, python-dotenv)
#   @USER@      Benutzer, unter dem das Dashboard laeuft

[Unit]
Description=IoT-Dashboard (Geraete-Monitor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@PYTHON@ @APP_DIR@/app.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
