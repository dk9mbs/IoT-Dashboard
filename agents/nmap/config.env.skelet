# Vorlage: nach config.env kopieren und Werte anpassen
#   cp config.env.skelet config.env && chmod 600 config.env
# Werte mit Leerzeichen oder Sonderzeichen ($ & ;) in '' setzen.

# Python-venv mit python-nmap und requests
VENV=/home/dk9mbs/src/restapi/venv/restapi

# Netz, das gescannt wird
NMAP_NETZ=192.168.2.0/24

# REST-Endpunkt fuer die gefundenen Geraete
REST_URL=http://localhost:5000/api/v1.0/data/iot_device

# Zugangsdaten fuer den REST-Server
REST_USER=username
REST_PASS=passwort
