#!/bin/bash
# Vorlage: nach run_scan_v2.sh kopieren und Zugangsdaten eintragen
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source /home/dk9mbs/src/restapi/venv/restapi/bin/activate
python3 "$SCRIPT_DIR/iptest_v2.py" \
  --netz 192.168.2.0/24 \
  --rest-url http://localhost:5000/api/v1.0/data/iot_device \
  --rest-user "username" \
  --rest-pass "passwort"
