# Vorlage: nach config.env kopieren und Werte anpassen
#   cp config.env.skelet config.env && chmod 600 config.env

# REST-Zugang (URL, API-Key) steht zentral in agents/agents.json.

# Nextcloud Talk (Standardkanal)
NEXTCLOUD_TALK_ENABLED=true
NEXTCLOUD_URL=
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=
NEXTCLOUD_TALK_ROOM_TOKEN=

# Telegram (optional, auch parallel zu Nextcloud Talk)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
