# Zugangsdaten - NIEMALS committen
.env
*.env
 
# Python
__pycache__/
*.pyc
*.egg-info/
build/
venv/
# gemeinsames venv fuer Dashboard und Agenten (install/install.sh)
.venv/
 
# Laufzeit-Zustandsdateien des Dashboards (gerätespezifisch, kein Quellcode)
pending_updates.json
device_status_state.json
 
# Session-Notizen (keine Quellcode-Doku)
session-notes.md

# Omada-Syslog-Agent: Betriebskonfiguration mit Netzwerk-/MAC-Daten,
# nicht die .skelet-Vorlagen
agents/omada_syslog/config.json
# nicht mehr benutzt (bekannte MACs kommen aus iot_device.mac), kann geloescht werden
agents/omada_syslog/known_macs.json

# nmap-Scan: Einstellungen mit REST-Zugangsdaten, nicht die .skelet-Vorlage
agents/nmap/config.env

# Agenten-Runner: Konfiguration mit API-Key sowie Logs/Sperrdateien
agents/agents.json
agents/logs/

# Editor/OS
.vscode/
.idea/
.DS_Store
*.swp
*.swo
*~


# nmap-Scan: Cache der Hersteller pro MAC-Prefix (wird automatisch angelegt)
agents/nmap/vendor_cache.json

# Shelly-Agent: Zeitpunkt der letzten Update-Pruefung je Geraet (wird automatisch angelegt)
agents/shelly/update_check_state.json

# Shelly-Syslog-Agent: bekannte Geräte der CLI (Netzwerkdaten, nicht die .skelet-Vorlage),
# Historie und Benachrichtigungs-Zustand (werden automatisch angelegt), Reports
agents/shelly_syslog/known_devices.json
agents/shelly_syslog/shelly_access_history.json
agents/shelly_syslog/notify_state.json
agents/shelly_syslog/report*.json
